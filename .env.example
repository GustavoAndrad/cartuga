# =============================================================================
# Cartuga - variáveis de ambiente
# Copie para `.env` (`cp .env.example .env`) e defina o JWT_SECRET (único passo
# obrigatório). O `.env` nunca é versionado.
# Os demais valores servem para rodar a demo NESTA máquina: o docker-compose publica
# as portas só em 127.0.0.1. Troque TODOS os segredos antes de expor a aplicação em
# qualquer outro ambiente.
# =============================================================================

# ---- MySQL -------------------------------------------------------------------
# Lidas pelo container `mysql` na PRIMEIRA inicialização do volume. Alterá-las
# depois não muda as credenciais de um volume já existente
# (use `docker compose down -v` para recriar do zero).
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=cartuga
MYSQL_USER=cartuga
MYSQL_PASSWORD=change_me

# Schema separado usado só pela suíte pytest (criado automaticamente por
# docker/mysql/init/01-test-database.sh na primeira inicialização do MySQL).
# Mantenha usuário/senha iguais a MYSQL_USER/MYSQL_PASSWORD.
TEST_DATABASE_URL=mysql+pymysql://cartuga:change_me@mysql:3306/cartuga_test

# ---- Autenticação (JWT) --------------------------------------------------------
# OBRIGATÓRIA e PRIVADA: o backend se recusa a subir sem ela, com menos de 32
# caracteres ou com o valor de exemplo abaixo (público, permitiria forjar sessões de
# ADMIN). A própria mensagem de erro sugere um valor pronto. Ou gere um:
#   Linux/macOS/Git Bash: openssl rand -base64 48
#   PowerShell: $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origens autorizadas a chamar a API (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# Flag "Secure" do cookie de refresh token. Navegadores tratam http://localhost
# como contexto seguro, então `true` funciona em dev local; use `false` só se o
# frontend não estiver em localhost nem em HTTPS.
COOKIE_SECURE=true

# ---- Usuário ADMIN inicial -----------------------------------------------------
# Criado no primeiro boot (idempotente: nunca sobrescreve um usuário existente).
# Estas são as credenciais PÚBLICAS da conta de demonstração documentada no README,
# para quem clonar o projeto entrar e já ver dados. Troque-as em qualquer ambiente
# que não seja uma demo local (o backend avisa no log se CORS_ORIGINS apontar para
# fora de localhost com esta senha).
INITIAL_ADMIN_NAME=Conta Demo
INITIAL_ADMIN_EMAIL=demo@cartuga.dev
INITIAL_ADMIN_PASSWORD=Cartuga@Demo2026

# ---- Câmbio --------------------------------------------------------------------
# A cotação oficial vem da PTAX do Banco Central (API pública). Estes valores são
# apenas o FALLBACK usado se a API estiver indisponível (quanto vale 1 BRL na moeda).
EXCHANGE_RATE_USD=0.19
EXCHANGE_RATE_EUR=0.17

# ---- Importação/exportação do banco ----------------------------------------------
# Diretório (dentro do container) onde os dumps pré-importação são gravados.
DB_BACKUP_DIR=/app/backups

# ---- Assistente Cartuga (chatbot) ------------------------------------------------
# Detalhes em docs/assistente.md. Provedor: groq (gratuito, padrão), ollama (local,
# 100% offline), openai_compatible (qualquer API no formato da OpenAI) ou disabled.
ASSISTANT_PROVIDER=groq
# Chave gratuita do Groq, sem cartão: https://console.groq.com/keys
# Vazia = o assistente aparece, mas avisa que não está configurado.
ASSISTANT_API_KEY=
# Limite por usuário (protege a cota gratuita do provedor).
ASSISTANT_MAX_MESSAGES_PER_HOUR=30
# Por quantos dias o histórico das conversas é guardado.
ASSISTANT_HISTORY_DAYS=7
# Rastreio do pipeline do assistente no terminal do backend, ao vivo, passo a passo:
# summary = passos, tempos, tokens, consultas e argumentos, sem o conteúdo do usuário;
# full = tudo (prompt, pergunta, resposta, dados consultados, raciocínio do modelo); off = nada.
# Independente disso, cada pergunta e teste de conexão fica completo em
# Gerenciamento → Logs do Assistente (cada administrador vê só os próprios).
ASSISTANT_TRACE_LOG=summary
# Formato no terminal: text (legível) ou json (uma linha JSON por passo).
ASSISTANT_TRACE_FORMAT=text
# Por quantos dias esses registros completos são guardados (0 = não guardar).
ASSISTANT_LOG_DAYS=30
# Onde está o Ollama (provedor "ollama"): o serviço do compose (docker compose
# --profile ollama up -d) ou, se instalado direto no Windows/Mac,
# http://host.docker.internal:11434/v1
ASSISTANT_OLLAMA_URL=http://ollama:11434/v1

# ---- Frontend --------------------------------------------------------------------
# URL da API vista pelo NAVEGADOR (porta do host). O docker-compose publica o
# backend em 8001 e o MySQL em 3307 para não conflitar com serviços locais nas
# portas padrão; entre containers a comunicação continua em backend:8000/mysql:3306.
# É a única variável repassada ao container do frontend.
VITE_API_BASE_URL=http://localhost:8001

# ---- Opcionais -------------------------------------------------------------------
# Já têm o valor padrão abaixo no código; descomente só para mudar.
#
# URL SQLAlchemy do backend. No Docker Compose ela é sempre montada a partir das
# variáveis MYSQL_* (docker-compose.yml) e um valor aqui é ignorado; só tem efeito
# ao rodar o backend fora do Compose.
# DATABASE_URL=mysql+pymysql://cartuga:change_me@localhost:3307/cartuga
#
# JWT_ALGORITHM=HS256
#
# Conexão usada por `mysqldump`/`mysql` no backup/restauração (o usuário, a senha
# e o banco vêm de MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE).
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
#
# Caminho dos binários do cliente MySQL dentro do container do backend.
# MYSQLDUMP_PATH=mysqldump
# MYSQL_RESTORE_PATH=mysql
#
# Assistente: já têm padrão por provedor (groq: openai/gpt-oss-120b com reserva
# openai/gpt-oss-20b; ollama: qwen3:8b em ASSISTANT_OLLAMA_URL).
# ASSISTANT_MODEL=
# ASSISTANT_FALLBACK_MODEL=
# ASSISTANT_BASE_URL=
# Por chamada ao modelo. Com Ollama sem GPU, use 180-300.
# ASSISTANT_TIMEOUT_SECONDS=60
# Criptografa as chaves de API que cada usuário salva no Perfil. Vazia = derivada
# do JWT_SECRET (trocar qualquer um dos dois exige que os usuários salvem a chave de novo).
# Se definida, também precisa ter 32+ caracteres aleatórios.
# ASSISTANT_ENCRYPTION_KEY=
